{
  "info": {
    "_postman_id": "b7c2e1d0-5a4b-4c3d-9e8f-112233445566",
    "name": "EsbeCashRecap - Transactions CRUD",
    "description": "Koleksi Postman untuk menguji endpoint transaksi (POST /transactions/cash, POST /transactions, GET /transactions, GET/PATCH/DELETE /transactions/{id}), validasi Joi, RBAC, akses lintas user, dan idempotency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "employeeToken", "value": "", "type": "string" },
    { "key": "createdTrxId", "value": "", "type": "string" },
    { "key": "ownerTrxId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0a. Login Owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login owner 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('ownerToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"owner\",\n  \"password\": \"owner123\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "0b. Login Employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login employee 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('employeeToken', pm.response.json().data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"employee\",\n  \"password\": \"employee123\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "1. POST /transactions/cash - Valid (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const trx = pm.response.json().data.transaction;",
              "pm.test('Status terkonfirmasi & amount number', () => {",
              "  pm.expect(trx.transaction_status).to.eql('terkonfirmasi');",
              "  pm.expect(trx.amount).to.be.a('number').and.eql(25000);",
              "});",
              "pm.collectionVariables.set('createdTrxId', trx.transaction_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fotokopi 100 lembar\",\n  \"transaction_type\": \"pemasukan\",\n  \"amount\": 25000,\n  \"shift\": \"pagi\",\n  \"category_id\": 1,\n  \"transaction_date\": \"2026-11-26\",\n  \"notes\": \"Pelanggan umum\",\n  \"idempotency_key\": \"cash-demo-001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/transactions/cash", "host": ["{{baseUrl}}"], "path": ["transactions", "cash"] }
      }
    },
    {
      "name": "2. POST /transactions/cash - Double Submit Idempotent (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK (idempotent)', () => pm.response.to.have.status(200));",
              "pm.test('ID transaksi sama', () => {",
              "  pm.expect(String(pm.response.json().data.transaction.transaction_id)).to.eql(String(pm.collectionVariables.get('createdTrxId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fotokopi 100 lembar\",\n  \"transaction_type\": \"pemasukan\",\n  \"amount\": 25000,\n  \"shift\": \"pagi\",\n  \"category_id\": 1,\n  \"transaction_date\": \"2026-11-26\",\n  \"notes\": \"Pelanggan umum\",\n  \"idempotency_key\": \"cash-demo-001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/transactions/cash", "host": ["{{baseUrl}}"], "path": ["transactions", "cash"] }
      }
    },
