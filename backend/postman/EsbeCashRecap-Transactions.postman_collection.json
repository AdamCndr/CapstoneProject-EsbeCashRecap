      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 30000,\n  \"notes\": \"Koreksi jumlah lembar\"\n}" },
        "url": { "raw": "{{baseUrl}}/transactions/{{createdTrxId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "{{createdTrxId}}"] }
      }
    },
    {
      "name": "13. DELETE /transactions/{id} - Employee Ditolak (403)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": { "raw": "{{baseUrl}}/transactions/{{createdTrxId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "{{createdTrxId}}"] }
      }
    },
    {
      "name": "14. DELETE /transactions/{id} - Owner Hapus (200)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
        "url": { "raw": "{{baseUrl}}/transactions/{{createdTrxId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "{{createdTrxId}}"] }
