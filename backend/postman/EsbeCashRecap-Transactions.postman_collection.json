        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Pembayaran QRIS Manual\",\n  \"transaction_type\": \"pemasukan\",\n  \"amount\": 75000,\n  \"shift\": \"siang\",\n  \"payment_method\": \"qris\",\n  \"is_manual_input\": true,\n  \"external_trx_id\": \"NMID-881234\",\n  \"transaction_date\": \"2026-11-26\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
      }
    },
    {
      "name": "8. POST /transactions - Non-tunai Tanpa Bukti & Manual (400)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"QRIS Tanpa Bukti\",\n  \"transaction_type\": \"pemasukan\",\n  \"amount\": 50000,\n  \"shift\": \"pagi\",\n  \"payment_method\": \"qris\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] }
      }
    },
    {
      "name": "9. GET /transactions - Filter & Paginasi (200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/transactions?shift=pagi&payment_method=tunai&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["transactions"],
          "query": [
            { "key": "shift", "value": "pagi" },
            { "key": "payment_method", "value": "tunai" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "10. GET /transactions/{id} - Akses Lintas User oleh Employee (403)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": { "raw": "{{baseUrl}}/transactions/{{ownerTrxId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "{{ownerTrxId}}"] }
      }
    },
    {
      "name": "11. PATCH /transactions/{id} - Employee Ditolak (403)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 30000\n}" },
        "url": { "raw": "{{baseUrl}}/transactions/{{createdTrxId}}", "host": ["{{baseUrl}}"], "path": ["transactions", "{{createdTrxId}}"] }
      }
    },
    {
