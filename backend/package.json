{
  "name": "esbe-cash-recap-backend",
  "version": "1.0.0",
  "description": "Backend API pencatatan dan rekapitulasi pendapatan Fotocopy Esbe Lampu Merah",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "migrate:create": "node-pg-migrate create --envPath .env",
    "db:init": "node database/migrate.js",
    "test": "node --test"
  },
  "keywords": [
    "hapi",
    "postgresql",
    "esbe-cash-recap"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/hapi": "^21.4.13",
    "@hapi/jwt": "^3.2.4",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "joi": "^18.3.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
