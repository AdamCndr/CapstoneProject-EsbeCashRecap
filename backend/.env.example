# ============================================================
# .env.example — Esbe Cash Recap Backend
# Salin file ini ke .env dan isi nilainya.
# JANGAN pernah commit file .env ke repository!
# ============================================================

# ---- Server ----
NODE_ENV=production
PORT=5000
# HOST di-set otomatis ke 0.0.0.0 oleh config.js saat NODE_ENV=production

# ---- CORS ----
# Pisahkan beberapa origin dengan koma (tanpa spasi di sekitar koma)
# Contoh: https://esbe-cashrecap.pages.dev,https://www.esbe.my.id
CORS_ORIGINS=https://esbe-cashrecap.pages.dev

# ---- Database (Neon PostgreSQL — WAJIB untuk production) ----
# Gunakan connection string Pooled dari dashboard Neon (port 5432, bukan pooler 6543)
# Format: postgres://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DB_NAME?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/DB_NAME?sslmode=require
DB_SSL=true

# ---- Database Lokal (opsional, digunakan jika DATABASE_URL tidak diisi) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone_project
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# ---- JWT Authentication ----
# Buat nilai acak panjang min. 32 karakter:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_32_chars_very_long_random_string
JWT_EXPIRE_MINUTES=60

# ---- Rate Limit Login ----
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# ---- Layanan AI OCR/LLM (FastAPI, dikelola Lutfy) ----
AI_SERVICE_URL=https://esbe-ai.onrender.com
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_API_KEY=your_ai_service_api_key

# ---- Supabase Storage (untuk gambar bukti pembayaran) ----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=payment-proofs

# ---- Telegram Bot (opsional) ----
TELEGRAM_BOT_TOKEN=
