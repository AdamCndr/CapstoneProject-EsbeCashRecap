# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS (Origin Frontend Cloudflare Pages / Vite Dev, pisahkan koma jika lebih dari satu)
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Neon / Cloud - utama untuk aplikasi & node-pg-migrate)
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require
DB_SSL=false

# PostgreSQL Lokal (opsional fallback jika DATABASE_URL tidak diisi)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone_project
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# JWT Authentication (@hapi/jwt)
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRE_MINUTES=60

# Rate Limit Login
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10

# Layanan AI OCR/LLM (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_API_KEY=your_ai_service_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=
